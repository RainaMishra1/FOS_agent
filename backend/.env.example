# -----------------------------------------------------------------------------
# Backend Environment Configuration (FOS Enterprise)
# Copy this file to .env for local development.
# Configure these variables in Render Service Settings > Environment.
# -----------------------------------------------------------------------------

# Server Configuration
PROJECT_NAME="FOS Agent Management System"
# Set ENVIRONMENT="production" and DEBUG=False on Render
ENVIRONMENT="development"
# Render automatically injects PORT. Use 8000 for local development.
PORT=8000
DEBUG=True

# CORS Configuration
# Local: ["http://localhost:3000","http://127.0.0.1:3000"]
# Production on Render: Include your Vercel production and custom domains:
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://your-frontend.vercel.app"]
# Optional regex to automatically permit preview deployments from Vercel:
CORS_ORIGIN_REGEX=https:\/\/.*\.vercel\.app

# Database (Supabase PostgreSQL with PostGIS)
# Async connection string for FastAPI SQLAlchemy 2.0 (asyncpg)
# Use transaction/session pooler port 6543 or 5432:
DATABASE_URL="postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
# Sync connection string for Alembic migrations (psycopg2)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Auth
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_JWT_SECRET="[YOUR-SUPABASE-JWT-SECRET]"
SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"

# Server-only keys; NEVER expose these to the browser or frontend!
SUPABASE_SERVICE_ROLE_KEY="[SERVER-ONLY-SUPABASE-SERVICE-ROLE-KEY]"
# Server-only registration secrets for admin and agent onboarding
ADMIN_REGISTRATION_KEY="[SERVER-ONLY-ADMIN-REGISTRATION-KEY]"
AGENT_REGISTRATION_KEY="[SERVER-ONLY-AGENT-REGISTRATION-KEY]"
# Optional allowlist for administrator registration in production
ADMIN_REGISTRATION_ALLOWLIST="admin@example.com"

# Geofence & Location Thresholds
GEOFENCE_RADIUS_METERS=100.0
MAX_ACCEPTABLE_GPS_ACCURACY_METERS=50.0
LOCATION_STALE_THRESHOLD_SECONDS=300

# Routing Services (OSRM & Nominatim)
OSRM_BASE_URL="http://router.project-osrm.org"
GEOCODING_SEARCH_URL="https://nominatim.openstreetmap.org/search"
GEOCODING_USER_AGENT="FOS-Enterprise/1.0 (field operations address lookup)"
