# -----------------------------------------------------------------------------
# Backend Environment Configuration
# Copy this file to .env and adjust values for your environment.
# -----------------------------------------------------------------------------

# Server Configuration
PROJECT_NAME="FOS Agent Management System"
ENVIRONMENT="development"
PORT=8000
DEBUG=True
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (Supabase PostgreSQL with PostGIS)
# Async connection string for FastAPI SQLAlchemy 2.0 (asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
# Sync connection string for Alembic migrations (psycopg2)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Auth
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_JWT_SECRET="[YOUR-SUPABASE-JWT-SECRET]"
SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"
# Server-only; never add this value to frontend environment variables.
SUPABASE_SERVICE_ROLE_KEY="[SERVER-ONLY-SUPABASE-SERVICE-ROLE-KEY]"
# Server-only registration secrets. Use independent, high-entropy values.
ADMIN_REGISTRATION_KEY="[SERVER-ONLY-ADMIN-REGISTRATION-KEY]"
AGENT_REGISTRATION_KEY="[SERVER-ONLY-AGENT-REGISTRATION-KEY]"
# Required for admin registration in production; comma-separated or JSON list.
ADMIN_REGISTRATION_ALLOWLIST="admin@example.com"

# Geofence & Location Thresholds
GEOFENCE_RADIUS_METERS=100.0
MAX_ACCEPTABLE_GPS_ACCURACY_METERS=50.0
LOCATION_STALE_THRESHOLD_SECONDS=300

# Routing Services (OSRM)
OSRM_BASE_URL="http://router.project-osrm.org"
GEOCODING_SEARCH_URL="https://nominatim.openstreetmap.org/search"
GEOCODING_USER_AGENT="FOS-Enterprise/1.0 (field operations address lookup)"
