# -----------------------------------------------------------------------------
# Frontend Environment Configuration (FOS Enterprise)
# Copy this file to .env.local for local development.
# Configure these variables in Vercel Project Settings > Environment Variables.
# -----------------------------------------------------------------------------

# Application URL
# Local: http://localhost:3000 | Production: https://your-frontend.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Backend FastAPI API Base URL
# Local: http://localhost:8000/api/v1 | Production: https://your-backend.onrender.com/api/v1
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"
# Legacy fallback (supported for backward compatibility)
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"

# Supabase Public Auth (Safe for browser client; only anon key here)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"

# Map & Operations Defaults
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LAT=12.9716
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LNG=77.5946
NEXT_PUBLIC_LOCATION_POLL_INTERVAL_MS=15000
